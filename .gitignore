# ---------------------------------------------------------------- 运行环境
# 虚拟环境 / 依赖目录：由 scripts/setup_env.bat 与 npm install 重建
.venv/
frontend/node_modules/
frontend/dist/

# Python 编译产物与工具缓存
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------- 运行时数据
# data/ 全部是运行产物：业务库、WAL、备份、上传原图、处理图、导出 xlsx、截图、
# 诊断脚本与令牌。config.py 启动时会自建目录，seed_all 会铺基础数据，不需要入库。
# 尤其 data/.secret（HMAC 签名密钥）与 worktime.db（工时/工资数据）绝不能上传。
data/

# 日志与界面实拍：调试产物，不是源码
logs/
*.log

# IDE / 助手本地数据（保留在磁盘上，只是不入库）
.workbuddy/
.codebuddy/

# ---------------------------------------------------------------- 原始台账
# doc/ 下是车间真实月度工时表 Excel，含人员姓名与工资数据，默认不入库。
# 确实要作为 fixtures 提交时：git add -f doc/xxx.xlsx
doc/*.xlsx

# ---------------------------------------------------------------- 本地快照/误产物
# 全量打包的历史快照（约 53MB），留在本地即可
hy1.rar
# 命令重定向误落到根目录的输出文件
/--out

# ---------------------------------------------------------------- 系统文件
Thumbs.db
.DS_Store
*.swp
